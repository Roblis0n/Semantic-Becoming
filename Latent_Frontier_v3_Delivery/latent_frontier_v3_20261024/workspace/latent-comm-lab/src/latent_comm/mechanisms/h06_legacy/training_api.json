{
  "schema_version": 3,
  "id": "H06",
  "status": "SOURCE_ONLY_NOT_RUN",
  "forward_entry": "latent_comm.mechanisms.h06_legacy.adapter.tensor_charts",
  "forward_entries": {
    "tensor_charts": {
      "entry": "latent_comm.mechanisms.h06_legacy.adapter.tensor_charts",
      "signature": "state, read_maps, write_maps, route_logits, coverage_mask, *, mode='soft'",
      "arguments": [
        "state",
        "read_maps",
        "write_maps",
        "route_logits",
        "coverage_mask",
        "mode"
      ]
    }
  },
  "loss_entry": "latent_comm.mechanisms.h06_legacy.losses.tensor_losses",
  "loss_signature": "effect, target, effect_valid, cycled, original, overlap_valid, encoded, encoded_valid, reconstructed, state, *, task_loss, min_std=0.1",
  "loss_input_bindings": {
    "effect": {
      "producer": "stage.common_behavior_readout on tensor_charts locals",
      "requires_gradient": true,
      "detached_supervision": false
    },
    "target": {
      "producer": "SupervisionBatch.target; loss-only, detached or discrete target",
      "requires_gradient": false,
      "detached_supervision": true
    },
    "effect_valid": {
      "producer": "stage explicit boolean effect_valid from typed applicability and supervision availability",
      "requires_gradient": false,
      "detached_supervision": false
    },
    "cycled": {
      "producer": "explicit ordered overlap transition maps",
      "requires_gradient": true,
      "detached_supervision": false
    },
    "original": {
      "producer": "starting chart encoding",
      "requires_gradient": true,
      "detached_supervision": false
    },
    "overlap_valid": {
      "producer": "stage explicit boolean overlap_valid from typed applicability and supervision availability",
      "requires_gradient": false,
      "detached_supervision": false
    },
    "encoded": {
      "producer": "one selected same-dimensional chart encoding",
      "requires_gradient": true,
      "detached_supervision": false
    },
    "encoded_valid": {
      "producer": "stage explicit boolean encoded_valid from typed applicability and supervision availability",
      "requires_gradient": false,
      "detached_supervision": false
    },
    "reconstructed": {
      "producer": "tensor_charts return[1]",
      "requires_gradient": true,
      "detached_supervision": false
    },
    "state": {
      "producer": "receiver state entering tensor_charts",
      "requires_gradient": true,
      "detached_supervision": false
    },
    "task_loss": {
      "producer": "stage task head on reconstruction",
      "requires_gradient": true,
      "detached_supervision": false
    },
    "min_std": {
      "producer": "recipe scalar hyperparameter min_std",
      "requires_gradient": false,
      "detached_supervision": false
    }
  },
  "loss_specs": [
    {
      "name": "task",
      "mathematical_definition": "stage normalized task loss after dedicated mechanism",
      "numerator": "sum valid task losses",
      "denominator": "valid task count",
      "valid_mask": "stage-normalized valid tasks",
      "zero_valid_policy": "differentiable_zero",
      "parameter_owners": [
        "mechanism_writer",
        "mechanism_reader"
      ],
      "requires_grad_inputs": [
        "task_loss"
      ],
      "stop_gradient_edges": [],
      "estimator": "EXACT",
      "normalization_units": "task instances"
    },
    {
      "name": "reconstruction",
      "mathematical_definition": "mean squared reconstruct(state)-state",
      "numerator": "sum of valid terms",
      "denominator": "count of valid terms",
      "valid_mask": "encoded_valid[:,None].expand_as(state)",
      "zero_valid_policy": "differentiable_zero",
      "parameter_owners": [
        "mechanism_writer",
        "mechanism_reader"
      ],
      "requires_grad_inputs": [
        "reconstructed",
        "state"
      ],
      "stop_gradient_edges": [],
      "estimator": "EXACT",
      "normalization_units": "state coordinates"
    },
    {
      "name": "effect",
      "mathematical_definition": "mean behavioral anchor squared error",
      "numerator": "sum of valid terms",
      "denominator": "count of valid terms",
      "valid_mask": "effect_valid",
      "zero_valid_policy": "differentiable_zero",
      "parameter_owners": [
        "mechanism_writer",
        "mechanism_reader"
      ],
      "requires_grad_inputs": [
        "effect"
      ],
      "stop_gradient_edges": [
        [
          "target",
          "target_or_return"
        ]
      ],
      "estimator": "EXACT",
      "normalization_units": "behavior coordinates"
    },
    {
      "name": "cycle",
      "mathematical_definition": "mean declared overlap cycle squared error",
      "numerator": "sum of valid terms",
      "denominator": "count of valid terms",
      "valid_mask": "overlap_valid",
      "zero_valid_policy": "differentiable_zero",
      "parameter_owners": [
        "mechanism_reader"
      ],
      "requires_grad_inputs": [
        "cycled",
        "original"
      ],
      "stop_gradient_edges": [],
      "estimator": "EXACT",
      "normalization_units": "chart elements"
    },
    {
      "name": "variance",
      "mathematical_definition": "mean relu(min_std-std(valid chart encodings))",
      "numerator": "sum coordinate standard-deviation hinge penalties",
      "denominator": "chart dimension; active only with >=2 valid rows",
      "valid_mask": "encoded_valid; at least two rows",
      "zero_valid_policy": "differentiable_zero",
      "parameter_owners": [
        "mechanism_writer"
      ],
      "requires_grad_inputs": [
        "encoded"
      ],
      "stop_gradient_edges": [],
      "estimator": "EXACT",
      "normalization_units": "chart coordinates"
    }
  ],
  "parameter_bindings": {
    "mechanism_writer": [
      "tensor_charts.read_maps",
      "stage.route_head"
    ],
    "mechanism_reader": [
      "tensor_charts.write_maps",
      "stage.overlap_transition_maps",
      "stage.common_behavior_readout"
    ]
  },
  "stage_parameter_rule": "Bindings beginning stage. are constructed by the L-stage, not implicit model parameters. Each actual Parameter must be uniquely assigned to exactly one owner, including shared aliases. Unlisted base parameters stay frozen.",
  "shared_training_engine": "latent_comm.learning.engine.train",
  "stage_api": [
    "parameter_groups()",
    "frozen_parameters()",
    "forward_roles(sender, receiver, maximum_unroll=...)",
    "losses(output, SupervisionBatch)",
    "loss_specs",
    "versions",
    "device"
  ],
  "input_contract": "RoleBatch projections only. Finite floating tensors including padding; exact mask shapes, valid class indices, and explicit typed applicability are required. Supervision is passed only to losses.",
  "loss_selection": "Select named LossSpec terms, never total plus its components. Non-LossSpec return fields are diagnostics. External task_loss inputs are already masked/normalized with differentiable empty zero by the L-stage.",
  "gradient_contract": "Freeze base parameters with requires_grad=False, not no_grad around receiver computation. Teacher targets only may be detached. A discrete sampled decision uses its live selected log probability; deterministic argmax does not impersonate a policy gradient.",
  "tokenizer_contract": "No cross-tokenizer direct logit KL. Shared token-mixture losses require identical declared vocabulary; heterogeneous receivers use named common behavior coordinates.",
  "execution": "All adapters and losses gate before tensor backend import. No neural test, model import, initialization, optimization or efficacy claim in this task."
}
