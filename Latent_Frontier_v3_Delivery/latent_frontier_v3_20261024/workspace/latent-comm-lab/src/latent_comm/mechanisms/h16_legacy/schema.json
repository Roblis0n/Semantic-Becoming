{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "latent_comm:H16:v3",
  "type": "object",
  "required": [
    "schema_version",
    "versions",
    "symbols",
    "latent_handle"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "versions": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "\\S"
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "ontology": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "isa": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "frame": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "world": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "task": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "required": [
        "evidence",
        "ontology",
        "schema",
        "task"
      ],
      "additionalProperties": false
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "decimal",
              "entity",
              "reference",
              "relation"
            ]
          },
          "value": {
            "type": "string",
            "pattern": "\\S"
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "origin_role": {
            "enum": [
              "public",
              "sender",
              "receiver"
            ]
          }
        },
        "required": [
          "name",
          "kind",
          "value",
          "unit",
          "source",
          "origin_role"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "latent_handle": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "additionalProperties": false
}
