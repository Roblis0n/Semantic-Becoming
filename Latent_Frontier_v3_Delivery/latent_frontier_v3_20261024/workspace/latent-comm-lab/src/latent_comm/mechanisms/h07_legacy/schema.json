        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "opcode": {
            "type": "string",
            "pattern": "\\S"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 64
          },
          "output_type": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "\\S"
              },
              "dimension": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 64
              },
              "frame": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "dimension",
              "frame"
            ],
            "additionalProperties": false
          },
          "bound": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          }
        },
        "required": [
          "node_id",
          "opcode",
          "inputs",
          "output_type",
          "bound"
        ],
        "additionalProperties": false
