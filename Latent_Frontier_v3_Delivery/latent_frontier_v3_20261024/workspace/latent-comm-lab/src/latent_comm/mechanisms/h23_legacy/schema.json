{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "latent_comm:H23:v3",
  "type": "object",
  "required": [
    "schema_version",
    "versions",
    "report_id",
    "kind",
    "message_digest",
    "probe_ids",
    "residual",
    "missing_variables",
    "conflicting_domains",
    "evidence_errors",
    "permitted_summary_fields",
    "conflict_edge_witness"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "versions": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "\\S"
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "ontology": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "isa": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "frame": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "world": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "task": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "required": [
        "evidence",
        "frame",
        "ontology",
        "schema",
        "state",
        "task"
      ],
      "additionalProperties": false
    },
    "report_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "none",
        "numeric",
        "semantic_domain",
        "missing_variable",
        "evidence_error"
      ]
    },
    "message_digest": {
      "type": "string",
      "pattern": "\\S"
    },
    "probe_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "residual": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "missing_variables": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "conflicting_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "evidence_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "permitted_summary_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "conflict_edge_witness": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "additionalProperties": false
}
