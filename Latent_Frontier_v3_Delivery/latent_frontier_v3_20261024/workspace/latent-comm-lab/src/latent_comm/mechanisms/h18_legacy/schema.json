{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "latent_comm:H18:v3",
  "type": "object",
  "required": [
    "schema_version",
    "versions",
    "nodes",
    "edges",
    "candidate_id",
    "output_node",
    "semantic_changes"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "versions": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "\\S"
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "ontology": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "isa": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "frame": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "world": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "task": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "required": [
        "isa",
        "ontology",
        "schema",
        "task"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "operation": {
            "enum": [
              "input",
              "identity",
              "negate",
              "sum",
              "product"
            ]
          },
          "input_type": {
            "const": "scalar"
          },
          "output_type": {
            "const": "scalar"
          },
          "cost": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "node_id",
          "operation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array",
            "object"
          ]
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 0,
      "maxItems": 128
    },
    "candidate_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "output_node": {
      "type": "string",
      "pattern": "\\S"
    },
    "semantic_changes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "additionalProperties": false
}
